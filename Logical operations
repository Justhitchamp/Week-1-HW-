if not raining:
  print("don't bring a umbrella")
else:
  print("bring a umbrella")
# using or "means only one of the stamenets need to be true in order for the statement to work". 
cloudy = True
cold = False
if cloudy or cold:
  print("It a bad day outside")
else:
  print("Go outside and play football")
# using And "means that both of the statements need to be true in order for it to work" 
