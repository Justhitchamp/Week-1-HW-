# this function makes a list of teams and picks one randomly
def pick_random_team():
    teams = []
    for team in nba_teams:      # uses a for loop to get a nba team
        teams.append(team)
    return random.choice(teams)   # picks and returns one random team from the list

# uses a function that gets a player from the user number
def pick_player(team, number):
    count = 1
    for player in nba_teams[team]:  # uses for loop to get the players from the selected team
        if count == number:
            return player
        count += 1

